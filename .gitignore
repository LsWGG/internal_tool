# Local Python environment and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Frontend dependencies/build output
node_modules/
frontend/dist/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Runtime data, uploads and generated exports
tmp/
backend/*_data/
backend/dbx_data/

# Version system settings; keep other runtime data ignored.
!backend/catalog_data/
backend/catalog_data/*
!backend/catalog_data/catalog.json
!backend/links_data/
backend/links_data/*
!backend/links_data/links.json
backend/**/uploads/
backend/**/outputs/
backend/cache/
backend/data/
*.log

# OS/editor files
.DS_Store
.idea/
.vscode/

# Model credentials are local only
backend/model_settings_data/
