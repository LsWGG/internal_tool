# Local Python environment and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Frontend dependencies/build output
node_modules/
frontend/dist/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Runtime data, uploads and generated exports
tmp/
backend/*_data/
backend/dbx_data/

# Version system settings; keep other runtime data ignored.
!backend/catalog_data/
backend/catalog_data/*
!backend/catalog_data/catalog.json
!backend/links_data/
backend/links_data/*
!backend/links_data/links.json
# Docker service management: the compose files are hand-written configuration, not cache.
!backend/compose_data/
# GitHub trending: version only the user's own favorites. The date-named daily reports
# are regenerated and pruned by the backend, so tracking them is pure churn.
!backend/github_trending_data/
backend/github_trending_data/*
!backend/github_trending_data/favorites.json
backend/**/uploads/
backend/**/outputs/
backend/cache/
backend/data/
*.log

# OS/editor files
.DS_Store
.idea/
.vscode/

# Model credentials are local only
backend/model_settings_data/
